{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  background-color: {{ section.settings.background_color }};
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}

.about-us-swap-{{ section.id }} {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rem;
}

.about-us-swap-{{ section.id }}.layout-left {
  flex-direction: row;
}

.about-us-swap-{{ section.id }}.layout-right {
  flex-direction: row-reverse;
}

.about-us-swap-{{ section.id }} .about-us-swap__media-col {
  flex: 1 1 calc(50% - 2rem);
  width: 100%;
}

.about-us-swap-{{ section.id }} .about-us-swap__content-col {
  flex: 1 1 calc(50% - 2rem);
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.about-us-swap__image-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 16px;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.about-us-swap__image-wrapper:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12);
}

.about-us-swap__picture {
  display: block;
  width: 100%;
}

.about-us-swap__img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
  border-radius: 16px;
}

.about-us-swap__subtitle {
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin: 0 0 1.2rem 0;
}

.about-us-swap__heading {
  font-size: calc(var(--font-heading-scale, 1) * 3.6rem);
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 2rem 0;
}

.about-us-swap__text {
  font-size: 1.5rem;
  line-height: 1.6;
  margin: 0 0 1.6rem 0;
}

.about-us-swap__text p {
  margin: 0 0 1.6rem 0;
}

.about-us-swap__text p:last-child {
  margin: 0;
}

.about-us-swap__text a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 0.3rem;
  transition: color var(--duration-short) ease;
}

.about-us-swap__text a:hover {
  color: #e62e2e;
}

@media screen and (max-width: 749px) {
  .about-us-swap-{{ section.id }} {
    gap: 3rem;
  }
  
  .about-us-swap-{{ section.id }}.mobile-layout-image_first {
    flex-direction: column;
  }
  
  .about-us-swap-{{ section.id }}.mobile-layout-text_first {
    flex-direction: column-reverse;
  }
  
  .about-us-swap-{{ section.id }} .about-us-swap__media-col,
  .about-us-swap-{{ section.id }} .about-us-swap__content-col {
    flex: 1 1 100%;
  }

  .about-us-swap__heading {
    font-size: 2.6rem;
  }
}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="about-us-swap-{{ section.id }} layout-{{ section.settings.desktop_image_alignment }} mobile-layout-{{ section.settings.mobile_layout }}">
      <div class="about-us-swap__media-col">
        <div class="about-us-swap__image-wrapper">
          <picture class="about-us-swap__picture">
            {%- if section.settings.image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
            {%- elsif section.settings.image != blank -%}
              <source media="(max-width: 749px)" srcset="{{ section.settings.image | image_url: width: 750 }}">
            {%- else -%}
              <source media="(max-width: 749px)" srcset="https://cdn.shopify.com/s/files/1/0994/2351/9085/files/shared_image_2.jpg?v=1784915589">
            {%- endif -%}
            
            {%- if section.settings.image != blank -%}
              <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" class="about-us-swap__img" loading="lazy">
            {%- else -%}
              <img src="https://cdn.shopify.com/s/files/1/0994/2351/9085/files/shared_image_2.jpg?v=1784915589" alt="Designed for real everyday living" class="about-us-swap__img" loading="lazy">
            {%- endif -%}
          </picture>
        </div>
      </div>
      <div class="about-us-swap__content-col">
        {%- if section.settings.subtitle != blank -%}
          <span class="about-us-swap__subtitle" style="color: {{ section.settings.subtitle_color }};">
            {{ section.settings.subtitle | escape }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="about-us-swap__heading" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="about-us-swap__text rte" style="color: {{ section.settings.text_color }};">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Us Swap Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Section Image"
    },
    {
      "type": "select",
      "id": "desktop_image_alignment",
      "options": [
        { "value": "left", "label": "Image on Left" },
        { "value": "right", "label": "Image on Right" }
      ],
      "default": "left",
      "label": "Desktop image alignment"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "label": "Mobile layout order"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR BEGINNINGS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "It Began With a Simple Belief"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our journey didn't begin with a perfect business plan. It began with a simple belief that everyday home essentials deserve to be better.</p><p>We come from a family with over 25 years in the steel and export business through Falcon International, a Government Recognized Star Export House. Growing up around it, we understood the value of quality materials, thoughtful craftsmanship and products built to last.</p>"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ff0000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top Desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom Desktop",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "About Us Swap Section"
    }
  ]
}
{% endschema %}
