{%- style -%}
#AboutUsBanner-{{ section.id }} {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
}

/* --- CHANGED: Adaptive height styling to prevent image cropping --- */
#AboutUsBanner-{{ section.id }}.height-adapt {
  display: block;
}
/* Render picture & image relatively so container height scales naturally with the aspect ratio */
#AboutUsBanner-{{ section.id }}.height-adapt .about-us-banner__picture {
  position: relative;
  width: 100%;
  height: auto;
  display: block;
  z-index: 1;
}
#AboutUsBanner-{{ section.id }}.height-adapt .about-us-banner__image {
  position: relative;
  width: 100%;
  height: auto;
  display: block;
  z-index: 1;
  object-fit: unset; /* Overrides object-fit: cover to prevent image cropping */
}
/* Absolutely position the overlay and text content so they layer over the naturally scaling container */
#AboutUsBanner-{{ section.id }}.height-adapt .about-us-banner__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}
#AboutUsBanner-{{ section.id }}.height-adapt .about-us-banner__content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  display: flex;
  align-items: center;
}
/* --- END OF CHANGE --- */
#AboutUsBanner-{{ section.id }}.height-small {
  height: 350px;
}
#AboutUsBanner-{{ section.id }}.height-medium {
  height: 500px;
}
#AboutUsBanner-{{ section.id }}.height-large {
  height: 650px;
}
#AboutUsBanner-{{ section.id }}.height-fullscreen {
  height: 100vh;
}

.about-us-banner__picture {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.about-us-banner__image {
  width: 100%;
  height: 100%;
  object-fit: fill;
  object-position: center;
}

.about-us-banner__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.about-us-banner__content {
  position: relative;
  z-index: 3;
  width: 100%;
  padding: 6rem 2rem;
  box-sizing: border-box;
}

.about-us-banner__content.alignment-left {
  text-align: left;
}
.about-us-banner__content.alignment-center {
  text-align: center;
}
.about-us-banner__content.alignment-right {
  text-align: right;
}

.about-us-banner__heading {
  margin: 0 auto;
  font-weight: 700;
  line-height: 1.2;
  max-width: 80rem;
}

.about-us-banner__heading.h1 {
  font-size: calc(var(--font-heading-scale, 1) * 4.2rem);
}
.about-us-banner__heading.h2 {
  font-size: calc(var(--font-heading-scale, 1) * 3.2rem);
}
.about-us-banner__heading.h3 {
  font-size: calc(var(--font-heading-scale, 1) * 2.4rem);
}

@media screen and (max-width: 749px) {
  .about-us-banner__heading.h1 {
    font-size: 2.8rem;
  }
  .about-us-banner__heading.h2 {
    font-size: 2.2rem;
  }
  .about-us-banner__heading.h3 {
    font-size: 1.8rem;
  }
  #AboutUsBanner-{{ section.id }}.height-small {
    height: 250px;
  }
  #AboutUsBanner-{{ section.id }}.height-medium {
    height: 350px;
  }
  #AboutUsBanner-{{ section.id }}.height-large {
    height: 450px;
  }
}
{%- endstyle -%}

<div id="AboutUsBanner-{{ section.id }}" class="about-us-banner height-{{ section.settings.banner_height }}">
  <picture class="about-us-banner__picture">
    {%- if section.settings.image_mobile != blank -%}
      <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
    {%- elsif section.settings.image != blank -%}
      <source media="(max-width: 749px)" srcset="{{ section.settings.image | image_url: width: 750 }}">
    {%- else -%}
      <source media="(max-width: 749px)" srcset="https://cdn.shopify.com/s/files/1/0994/2351/9085/files/shared_image_2.jpg?v=1784915589">
    {%- endif -%}
    
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" class="about-us-banner__image" loading="eager">
    {%- else -%}
      <img src="https://cdn.shopify.com/s/files/1/0994/2351/9085/files/shared_image_2.jpg?v=1784915589" alt="{{ section.settings.heading | escape }}" class="about-us-banner__image" loading="eager">
    {%- endif -%}
  </picture>
  <div class="about-us-banner__overlay" style="background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  <div class="about-us-banner__content alignment-{{ section.settings.text_alignment }}">
    <div class="page-width">
      <h1 class="about-us-banner__heading {{ section.settings.heading_size }}" style="color: {{ section.settings.text_color }};">
        {{ section.settings.heading | escape }}
      </h1>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Us Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Banner Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday home essentials deserve to be better"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "banner_height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "fullscreen", "label": "Full screen" }
      ],
      "default": "medium",
      "label": "Banner height"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Text alignment"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "About Us Banner"
    }
  ]
}
{% endschema %}
