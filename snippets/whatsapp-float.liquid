<style>
  .wa-float-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999999;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .wa-btn {
    position: relative;
    width: 60px;
    height: 60px;
    background-color: #25d366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
  }

  .wa-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.55);
  }

  .wa-btn svg {
    width: 32px;
    height: 32px;
    fill: #ffffff;
    position: relative;
    z-index: 2;
  }

  /* Red Notification Dot */
  .wa-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 14px;
    height: 14px;
    background-color: #ff3b30;
    border: 2px solid #ffffff;
    border-radius: 50%;
    z-index: 3;
  }

  /* Pulsing Animation Rings (matching screenshot style) */
  .wa-pulse-ring {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.22);
    border: 1.5px solid rgba(37, 211, 102, 0.45);
    animation: waPulse 2.4s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
    pointer-events: none;
    z-index: 1;
  }

  .wa-pulse-ring-delayed {
    animation-delay: 1.2s;
  }

  @keyframes waPulse {
    0% {
      transform: scale(0.82);
      opacity: 0.9;
    }
    70% {
      transform: scale(1.45);
      opacity: 0.15;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  /* Tooltip Box */
  .wa-tooltip {
    background: #ffffff;
    color: #121212;
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.14);
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s ease;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .wa-tooltip.wa-tooltip-hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateX(10px);
    pointer-events: none;
  }

  .wa-float-wrapper:hover .wa-tooltip.wa-tooltip-hidden {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .wa-tooltip span {
    font-size: 11px;
    color: #666666;
    font-weight: 400;
  }

  .wa-tooltip::after {
    content: "";
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    border-width: 6px 0 6px 6px;
    border-style: solid;
    border-color: transparent transparent transparent #ffffff;
  }

  /* Mobile responsiveness */
  @media (max-width: 749px) {
    .wa-float-wrapper {
      bottom: 18px;
      right: 18px;
    }
    .wa-btn {
      width: 52px;
      height: 52px;
    }
    .wa-btn svg {
      width: 28px;
      height: 28px;
    }
    .wa-tooltip {
      font-size: 12px;
      padding: 8px 12px;
    }
    .wa-tooltip span {
      font-size: 10px;
    }
  }
</style>

<script>
  setTimeout(function() {
    var tooltip = document.getElementById('waTooltip');
    if (tooltip) {
      tooltip.classList.add('wa-tooltip-hidden');
    }
  }, 3000);
</script>
