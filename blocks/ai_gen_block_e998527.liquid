        </a>
      {% endif %}

      {% if block.settings.image_4 != blank %}
        <a href="{{ block.settings.link_4.url }}" class="category-item">
          <div class="category-img-wrapper">
            <img src="{{ block.settings.image_4 | img_url: '400x400' }}" alt="{{ block.settings.title_4 }}" loading="lazy">
          </div>
          <p class="category-title">{{ block.settings.title_4 }}</p>
        </a>
