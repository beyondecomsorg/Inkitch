            <img src="{{ block.settings.image_5 | img_url: '400x400' }}" alt="{{ block.settings.title_5 }}" loading="lazy">
          </div>
          <p class="category-title">{{ block.settings.title_5 }}</p>
        </a>
      {% endif %}

      {% if block.settings.image_6 != blank %}
        <a href="{{ block.settings.link_6.url }}" class="category-item">
          <div class="category-img-wrapper">
            <img src="{{ block.settings.image_6 | img_url: '400x400' }}" alt="{{ block.settings.title_6 }}" loading="lazy">
