<div class="category-circles-section">

  <div class="category-heading-wrapper">
    <h2 class="category-heading">
      {{ block.settings.heading }}
    </h2>
    <p class="category-subtitle">Better-built home essentials for everyday use.</p>
  </div>

  <div class="category-slider-wrapper">
    <div class="category-slider">

      {% if block.settings.image_1 != blank %}
        <a href="{{ block.settings.link_1.url }}" class="category-item">
          <div class="category-img-wrapper">
            <img src="{{ block.settings.image_1 | img_url: '400x400' }}" alt="{{ block.settings.title_1 }}" loading="lazy">
          </div>
          <p class="category-title">{{ block.settings.title_1 }}</p>
        </a>
      {% endif %}

      {% if block.settings.image_2 != blank %}
