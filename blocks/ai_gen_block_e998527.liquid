          <div class="category-img-wrapper">
            <img src="{{ block.settings.image_7 | img_url: '400x400' }}" alt="{{ block.settings.title_7 }}" loading="lazy">
          </div>
          <p class="category-title">{{ block.settings.title_7 }}</p>
        </a>
      {% endif %}

      {% if block.settings.image_8 != blank %}
        <a href="{{ block.settings.link_8.url }}" class="category-item">
          <div class="category-img-wrapper">
            <img src="{{ block.settings.image_8 | img_url: '400x400' }}" alt="{{ block.settings.title_8 }}" loading="lazy">
          </div>
          <p class="category-title">{{ block.settings.title_8 }}</p>
        </a>
      {% endif %}

    </div>
  </div>

</div>

<style>
.category-circles-section {
  background-color: #fafafa;
  padding: 20px 20px;
  position: relative;
  overflow: hidden;
}

.category-heading-wrapper {
  text-align: center;
  margin-bottom: 24px;
}

.category-heading {
  font-size: 32px;
  font-weight: 700;
  color: #121212;
  margin: 0 0 6px 0;
  line-height: 1.2;
  position: relative;
  display: inline-block;
  font-family: var(--font-heading-family), serif;
}

.category-subtitle {
  font-size: 14px;
  color: #666666;
  margin: 0;
  font-family: var(--font-body-family), sans-serif;
}

.category-slider-wrapper {
  max-width: 1320px;
  margin: 0 auto;
}

.category-slider {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  gap: 24px;
  padding: 8px 4px 0px 4px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.category-slider::-webkit-scrollbar {
  display: none;
}

.category-item {
  flex: 0 0 auto;
  width: 135px;
  text-align: center;
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  scroll-snap-align: start;
}

.category-img-wrapper {
  width: 125px;
  height: 125px;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  background-color: #ffffff;
  border: 2px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.07);
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.category-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.category-item:hover .category-img-wrapper {
  border-color: #B5121B;
  box-shadow: 0 10px 24px rgba(181, 18, 27, 0.22);
  transform: translateY(-4px);
}

.category-item:hover img {
  transform: scale(1.08);
}

.category-title {
  font-size: 14px;
  font-weight: 600;
  color: #121212;
  margin: 12px 0 0 0;
  line-height: 1.3;
  transition: color 0.3s ease;
}

.category-item:hover .category-title {
  color: #B5121B;
}

@media screen and (max-width: 989px) {
  .category-slider {
    justify-content: flex-start;
    gap: 18px;
  }
}

@media screen and (max-width: 749px) {
  .category-circles-section {
    padding: 20px 16px;
  }

  .category-heading {
    font-size: 24px;
  }

  .category-heading-wrapper {
    margin-bottom: 18px;
  }

  .category-item {
    width: 110px;
  }

  .category-img-wrapper {
    width: 100px;
    height: 100px;
  }

  .category-title {
    font-size: 12.5px;
    margin-top: 10px;
  }
}
</style>

